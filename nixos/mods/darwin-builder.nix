# register `phliptop-mbp` as an intermittently available aarch64-darwin remote
# builder.
#
# `phliptop-mbp` runs `darwin-builder-serve` (pkgs/darwin-builder-serve.nix),
# which opens a reverse tunnel from this machine's `127.0.0.1:22023` to a
# user-owned sshd on the macOS machine.
#
# See: <../../doc/DARWIN-BUILDER.md>
{ config, lib, ... }:

let
  cfg = config.phlip9.darwin-builder;

  # nix-daemon connects to `phliptop-mbp` via this ssh alias. Keep in sync with
  # <../../pkgs/darwin-builder-serve.nix>.
  hostAlias = "phliptop-mbp-builder";

  # phliptop-mbp's darwin builder sshd host pubkey. Generated by
  # `darwin-builder-serve` on first run.
  hostPublicKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAsnrrEChMI9jxAJWvqYF/x2/oNn9cecuS2tbpHMqHG9 phliptop-mbp-builder-host";

  # per-user client private key for connections to `phliptop-mbp`. `%d` is the
  # user's home dir:
  #
  # - root: nix-daemon's build hook
  # - phlip9: `nix build --store ssh-ng://phliptop-mbp-builder` builds
  #
  # keep pubkeys in sync with <../../pkgs/darwin-builder-serve.nix>.
  sshKey = "%d/.ssh/phliptop-mbp-builder";
in
{
  options.phlip9.darwin-builder = {
    enable = lib.mkEnableOption "intermittent aarch64-darwin remote builder";
  };

  config = lib.mkIf cfg.enable {
    nix.distributedBuilds = true;
    # `phliptop-mbp` fetches deps from its own substituters instead of `sauna`.
    nix.settings.builders-use-substitutes = true;
    nix.buildMachines = [
      {
        hostName = hostAlias;
        protocol = "ssh-ng";
        systems = [ "aarch64-darwin" ];
        sshUser = "phlip9";
        # key comes from the ssh alias
        # match the `phliptop-mbp`'s `max-jobs` and `system-features`.
        maxJobs = 8;
        supportedFeatures = [
          "apple-virt"
          "benchmark"
          "big-parallel"
          "nixos-test"
        ];
      }
    ];

    programs.ssh.knownHosts.${hostAlias}.publicKey = hostPublicKey;

    # phliptop-mbp (home WiFi) <-> sauna connection: ~1 MiB/s, ~190ms RTT
    # TODO(phlip9): measure work <-> sauna
    #
    # - under load, handshakes and keepalives queue behind output uploads.
    # - ControlMaster: reuse one connection. nix's build hook otherwise opens
    #   a new connection per drv.
    # - Compression: many outputs compress 2-16x.
    # - ConnectTimeout, ServerAlive: one failed connect at any point disables
    #   the builder for the entire `nix build`, so make it less aggressive.
    programs.ssh.extraConfig = ''
      Host ${hostAlias}
        HostName 127.0.0.1
        Port 22023
        User phlip9
        IdentityFile ${sshKey}
        IdentityAgent none
        IdentitiesOnly yes
        HostKeyAlias ${hostAlias}
        UserKnownHostsFile /dev/null
        StrictHostKeyChecking yes
        BatchMode yes
        ControlMaster auto
        ControlPath %d/.ssh/cm-%C
        ControlPersist 10m
        Compression yes
        ConnectTimeout 30
        ServerAliveInterval 15
        ServerAliveCountMax 4
    '';

    # drop the reverse forward listener ~60s after `phliptop-mbp` connection
    # drops. applies to all SSH sessions.
    services.openssh.settings = {
      ClientAliveInterval = 15;
      ClientAliveCountMax = 4;
    };
  };
}
