+/// `/readyz` would answer ok now.
+async fn readyz_ok(status: &Arc<NodeStatus>) -> Result<bool, NodeError> {
+    let status = Arc::clone(status);
+    tokio::task::spawn_blocking(move || {
+        let _g = BlockingRegion::enter();
+        readiness(&status.ready_snapshot()).is_ok()
+    })
+    .await
+    .map_err(|e| NodeError::Config(format!("readiness task: {e}")))
+}
+
+/// Run `--startup-notify` through `sh -c` and wait for it, unless the node
+/// is stopping.
+fn run_startup_notify(cmd: Option<&str>, shutdown: &Shutdown) {
+    let Some(cmd) = cmd.filter(|_| !shutdown.requested()) else {
+        return;
+    };
+    match std::process::Command::new("sh").arg("-c").arg(cmd).status() {
+        Ok(st) if st.success() => {}
+        Ok(st) => warn!("startup-notify exited {st}: {cmd}"),
+        Err(e) => warn!("startup-notify failed: {e}: {cmd}"),
+    }
+}
