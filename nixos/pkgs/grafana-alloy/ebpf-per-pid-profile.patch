+// WithoutPID returns t w/o its `__process_pid__` label, ex: to merge the
+// profiles of all pids w/ otherwise equal labels. t itself if it has none.
+func (t *Target) WithoutPID() *Target {
+	if !t.labels.Has(labelPID) {
+		return t
+	}
+	ls := labels.NewBuilder(t.labels).Del(labelPID).Labels()
+	return &Target{
+		labels:      ls,
+		fingerprint: ls.Hash(),
+		serviceName: t.serviceName,
+	}
+}
+
 func (t *Target) String() string {
 	return t.labels.String()
 }
