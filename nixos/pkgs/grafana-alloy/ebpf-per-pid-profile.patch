 func (b *ProfileBuilders) BuilderForSample(
 	target *discovery.Target,
 	pid uint32,
 ) (*ProfileBuilder, error) {
+	if b.opt.PerPIDProfile {
+		return b.builderForTarget(target, pid)
+	}
+
+	// Merge pids: a pid's target has its pid as a label, drop it
+	if res := b.byTarget[target]; res != nil {
+		return res, nil
+	}
+	res, err := b.builderForTarget(target.WithoutPID(), 0)
+	if err != nil {
+		return nil, err
+	}
+	b.byTarget[target] = res
+	return res, nil
+}
