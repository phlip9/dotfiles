+// createMergedProfiles builds one profile per (profile type, labels) from
+// the events of all pids, see Config.PerPIDProfile.
+func (p *PPROFReporter) createMergedProfiles(tree samples.TraceEventsTree) []PPROF {
+	defer func() {
+		if p.symbols != nil {
+			p.symbols.Cleanup()
+		}
+	}()
 
+	// Keyed by value: equal types from different pids share builders
+	builders := make(map[samples.TypeMetadata]*ProfileBuilders)
+	for resourceKey, rtp := range tree {
+		for profileType, events := range rtp.Events {
+			bs := builders[*profileType]
+			if bs == nil {
+				bs = NewProfileBuilders(BuildersOptions{
+					SampleRate:    p.cfg.SamplesPerSecond,
+					PerPIDProfile: false,
+					ProfileType:   profileType,
+				})
+				builders[*profileType] = bs
+			}
+			// Only fails for an unsupported profile type, before it adds
+			// any samples, so skipping this pid's events is enough.
+			if err := p.addEvents(bs, resourceKey, events); err != nil {
+				p.log.Error("failed to create profile builder", "err", err)
+			}
+		}
+	}
+
+	var res []PPROF
+	for _, bs := range builders {
+		res = append(res, p.encodeProfiles(bs)...)
+	}
+	return res
+}
