+func TestPPROFReporter_PerPIDProfile(t *testing.T) {
+	// pids 1 + 2 share labels, pid 3 doesn't
+	targets := []discovery.DiscoveredTarget{
+		{"__process_pid__": "1", "service_name": "service_a"},
+		{"__process_pid__": "2", "service_name": "service_a"},
+		{"__process_pid__": "3", "service_name": "service_b"},
+	}
+	// Equal profile types of different pids can be different pointers
+	cpuType := *profileTypeSampling
+	trace := func(funcName string) samples.SampleToEvents {
+		return samples.SampleToEvents{
+			{}: &samples.TraceEvents{
+				Frames: singleFrameTrace(libpf.PythonFrame, libpf.FrameMappingFile{}, 0x30,
+					funcName, "/bin/bar", 1),
+				Timestamps: []uint64{42},
+			},
+		}
+	}
+	tree := func() samples.TraceEventsTree {
+		return samples.TraceEventsTree{
+			{PID: 1}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+				profileTypeSampling: trace("a1"),
+				profileTypeOffCPU:   trace("a1_off"),
+			}},
+			{PID: 2}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+				&cpuType: trace("a2"),
+			}},
+			{PID: 3}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+				profileTypeSampling: trace("b3"),
+			}},
+		}
+	}
+	// One report of tree(), profiles by "<__name__>/<service_name>"
+	report := func(perPID bool) map[string][]PPROF {
+		var profiles []PPROF
+		tp := discovery.NewTargetProducer(discovery.TargetsOptions{Targets: targets})
+		rep := NewPPROF(slog.New(slog.DiscardHandler),
+			&Config{SamplesPerSecond: 97, PerPIDProfile: perPID},
+			tp, nil,
+			func(_ context.Context, ps []PPROF) { profiles = ps })
+		events := rep.traceEvents.WLock()
+		*events = tree()
+		rep.traceEvents.WUnlock(&events)
+		rep.reportProfile(context.Background())
+		res := make(map[string][]PPROF)
+		for _, p := range profiles {
+			k := p.Labels.Get("__name__") + "/" + p.Labels.Get("service_name")
+			res[k] = append(res[k], p)
+		}
+		return res
+	}
+	funcNames := func(p PPROF) []string {
+		parsed, err := profile.Parse(bytes.NewReader(p.Raw))
+		require.NoError(t, err)
+		var res []string
+		for _, s := range parsed.Sample {
+			res = append(res, s.Location[0].Line[0].Function.Name)
+		}
+		return res
+	}
+
+	// Default: one profile per (labels, pid)
+	perPID := report(true)
+	assert.Len(t, perPID["process_cpu/service_a"], 2)
+	assert.Len(t, perPID["process_cpu/service_b"], 1)
+	assert.Len(t, perPID["offcpu/service_a"], 1)
+	assert.NotEmpty(t, perPID["process_cpu/service_a"][0].Labels.Get("__process_pid__"))
+
+	// Merged: one profile per labels, w/ every pid's samples, w/o the pid
+	merged := report(false)
+	assert.Len(t, merged, 3)
+	require.Len(t, merged["process_cpu/service_a"], 1)
+	a := merged["process_cpu/service_a"][0]
+	assert.Equal(t, 2, a.Samples)
+	assert.ElementsMatch(t, []string{"a1", "a2"}, funcNames(a))
+	assert.Empty(t, a.Labels.Get("__process_pid__"))
+	assert.Equal(t, pyroscope.ScopeNameEBPF, a.Labels.Get(pyroscope.LabelOtelScopeName))
+	require.Len(t, merged["process_cpu/service_b"], 1)
+	assert.Equal(t, []string{"b3"}, funcNames(merged["process_cpu/service_b"][0]))
+	require.Len(t, merged["offcpu/service_a"], 1)
+	assert.Equal(t, []string{"a1_off"}, funcNames(merged["offcpu/service_a"][0]))
+}
