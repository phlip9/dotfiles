+++ b/internal/component/pyroscope/ebpf/discovery/snapshot_test.go
@@ -0,0 +1,45 @@
+package discovery
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSnapshot(t *testing.T) {
+	opts := exitedTestOptions(30*time.Second, false)
+	tf, clock := exitedTestProducer(t, opts)
+	pids := func(targets []PIDTarget) []uint32 {
+		var res []uint32
+		for _, target := range targets {
+			res = append(res, target.PID)
+		}
+		return res
+	}
+
+	snap := tf.Snapshot()
+	require.ElementsMatch(t, []uint32{10, 11}, pids(snap.Live))
+	require.Empty(t, snap.Exited)
+
+	// pid 10 exits: retained, w/ when it left
+	left := clock.now
+	tf.Update(opts("11"))
+	snap = tf.Snapshot()
+	require.Equal(t, []uint32{11}, pids(snap.Live))
+	require.Len(t, snap.Exited, 1)
+	require.Equal(t, uint32(10), snap.Exited[0].PID)
+	require.Equal(t, "a10", snap.Exited[0].Labels.Get("service_name"))
+	require.Equal(t, left, snap.Exited[0].Since)
+	require.True(t, snap.Live[0].Since.IsZero())
+
+	// Expired, before any Update or lookup drops it
+	clock.now = clock.now.Add(30 * time.Second)
+	require.Empty(t, tf.Snapshot().Exited)
+
+	// No retention: never exited
+	opts = exitedTestOptions(0, false)
+	tf, _ = exitedTestProducer(t, opts)
+	tf.Update(opts("11"))
+	require.Empty(t, tf.Snapshot().Exited)
+}
