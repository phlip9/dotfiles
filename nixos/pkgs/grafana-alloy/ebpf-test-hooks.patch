diff -ruN a/internal/component/pyroscope/ebpf/reporter/flush.go b/internal/component/pyroscope/ebpf/reporter/flush.go
--- a/internal/component/pyroscope/ebpf/reporter/flush.go
+++ b/internal/component/pyroscope/ebpf/reporter/flush.go
@@ -0,0 +1,105 @@
+//go:build unix
+
+package reporter
+
+import (
+	"context"
+	"time"
+
+	"github.com/grafana/alloy/internal/component/pyroscope/ebpf/discovery"
+)
+
+// Test hooks: flush on demand, inspect the samples awaiting a flush. Unused
+// unless the component enables its test hooks; w/o a Flush call the
+// reporting loop behaves as upstream.
+
+// FlushResult is one manual flush, see Flush.
+type FlushResult struct {
+	// Before the flush took the pending samples, and after the consumer
+	// returned: its profiles are stamped in [Start, End]. Flushes are
+	// serial, and the flush before this one ended >= 2 ms boundaries
+	// before Start, see manualFlush.
+	Start, End time.Time
+	// What the consumer got
+	Profiles []PPROF
+}
+
+// flushReq asks the reporting loop for a flush, see Flush.
+type flushReq struct {
+	hold bool
+	// Buffered: the loop never waits for a requester that gave up
+	done chan FlushResult
+}
+
+// Flush builds + consumes the samples since the last flush now, on the
+// reporting loop, and returns once the consumer returned. W/ hold, the
+// loop then skips its periodic flushes until the next Flush w/o hold:
+// every sample from now on goes to that next Flush. Blocks until the loop
+// runs (see Start) or ctx ends.
+func (p *PPROFReporter) Flush(ctx context.Context, hold bool) (FlushResult, error) {
+	req := flushReq{hold: hold, done: make(chan FlushResult, 1)}
+	select {
+	case p.flushReqs <- req:
+	case <-ctx.Done():
+		return FlushResult{}, ctx.Err()
+	}
+	select {
+	case res := <-req.done:
+		return res, nil
+	case <-ctx.Done():
+		return FlushResult{}, ctx.Err()
+	}
+}
+
+// manualFlush is one Flush, on the reporting loop, after the flush that
+// ended at `prev`. Queries take ms: starts >= 2 ms boundaries after `prev`,
+// so no ms holds stamps of both, and [Start, End] widened to whole ms
+// holds no other flush's profiles (manual flushes run in order, the next
+// periodic one is a full interval later).
+func (p *PPROFReporter) manualFlush(ctx context.Context, prev time.Time) FlushResult {
+	time.Sleep(time.Until(time.UnixMilli(prev.UnixMilli() + 2)))
+	start := time.Now()
+	profiles := p.reportProfile(ctx)
+	return FlushResult{Start: start, End: time.Now(), Profiles: profiles}
+}
+
+// PendingSamples counts one pid's samples of one profile type that await
+// the next flush.
+type PendingSamples struct {
+	PID int64 `json:"pid"`
+	// `__name__` of the profile: discovery.MetricValueProcessCPU or
+	// discovery.MetricValueOffCPU
+	Type    string `json:"type"`
+	Samples int    `json:"samples"`
+}
+
+// Pending returns the samples since the last flush, per (pid, profile
+// type). Samples the profiler hasn't handed to the reporter yet don't
+// count.
+func (p *PPROFReporter) Pending() []PendingSamples {
+	type key struct {
+		pid int64
+		typ string
+	}
+	counts := make(map[key]int)
+	tree := p.traceEvents.RLock()
+	for resourceKey, rtp := range *tree {
+		// Equal profile types can be different pointers: sum per name
+		for profileType, events := range rtp.Events {
+			typ := discovery.MetricValueProcessCPU
+			if profileType.ReportValues {
+				typ = discovery.MetricValueOffCPU
+			}
+			for _, event := range events {
+				counts[key{resourceKey.PID, typ}] += len(event.Timestamps)
+			}
+		}
+	}
+	p.traceEvents.RUnlock(&tree)
+
+	res := make([]PendingSamples, 0, len(counts))
+	for pidType, count := range counts {
+		res = append(res, PendingSamples{PID: pidType.pid, Type: pidType.typ, Samples: count})
+	}
+	return res
+}
diff -ruN a/internal/component/pyroscope/ebpf/reporter/flush_test.go b/internal/component/pyroscope/ebpf/reporter/flush_test.go
--- a/internal/component/pyroscope/ebpf/reporter/flush_test.go
+++ b/internal/component/pyroscope/ebpf/reporter/flush_test.go
@@ -0,0 +1,153 @@
+//go:build unix
+
+package reporter
+
+import (
+	"bytes"
+	"context"
+	"log/slog"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/google/pprof/profile"
+	"github.com/grafana/alloy/internal/component/pyroscope/ebpf/discovery"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/ebpf-profiler/libpf"
+	"go.opentelemetry.io/ebpf-profiler/reporter/samples"
+)
+
+// flushTestReporter is a started reporter w/ pid 1 = service_a, flushing
+// every `interval`, that records what it consumes.
+type flushTestReporter struct {
+	*PPROFReporter
+	mu       sync.Mutex
+	consumed [][]PPROF
+}
+
+func newFlushTestReporter(t *testing.T, interval time.Duration) *flushTestReporter {
+	tp := discovery.NewTargetProducer(discovery.TargetsOptions{
+		Targets: []discovery.DiscoveredTarget{
+			{"__process_pid__": "1", "service_name": "service_a"},
+		},
+	})
+	res := &flushTestReporter{}
+	res.PPROFReporter = NewPPROF(slog.New(slog.DiscardHandler),
+		&Config{ReportInterval: interval, SamplesPerSecond: 97},
+		tp, nil,
+		func(_ context.Context, ps []PPROF) {
+			res.mu.Lock()
+			defer res.mu.Unlock()
+			res.consumed = append(res.consumed, ps)
+		})
+	require.NoError(t, res.Start(t.Context()))
+	t.Cleanup(res.Stop)
+	return res
+}
+
+// addSample adds one CPU sample of pid 1 in `fn`, as the profiler does.
+func (r *flushTestReporter) addSample(t *testing.T, fn string) {
+	trace := &libpf.Trace{
+		Frames: singleFrameTrace(libpf.PythonFrame, libpf.FrameMappingFile{}, 0x30,
+			fn, "/bin/bar", 1),
+	}
+	require.NoError(t, r.ReportTraceEvent(trace, &samples.TraceEventMeta{
+		PID:         1,
+		ProfileType: profileTypeSampling,
+		Timestamp:   42,
+	}))
+}
+
+func (r *flushTestReporter) flushes() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.consumed)
+}
+
+func TestPPROFReporter_Flush(t *testing.T) {
+	rep := newFlushTestReporter(t, time.Hour)
+	rep.addSample(t, "f0")
+	require.Equal(t, []PendingSamples{
+		{PID: 1, Type: discovery.MetricValueProcessCPU, Samples: 1},
+	}, rep.Pending())
+
+	// Returns after the consumer got the profile, stamped w/in the result
+	res, err := rep.Flush(t.Context(), false)
+	require.NoError(t, err)
+	require.Equal(t, 1, rep.flushes())
+	require.Len(t, res.Profiles, 1)
+	require.Equal(t, "service_a", res.Profiles[0].Labels.Get("service_name"))
+	parsed, err := profile.Parse(bytes.NewReader(res.Profiles[0].Raw))
+	require.NoError(t, err)
+	stamp := time.Unix(0, parsed.TimeNanos)
+	require.False(t, stamp.Before(res.Start), "%v < %v", stamp, res.Start)
+	require.False(t, res.End.Before(stamp), "%v < %v", res.End, stamp)
+	require.Empty(t, rep.Pending())
+
+	// Nothing pending: an empty flush, >= 2 ms boundaries after the last
+	prev := res
+	res, err = rep.Flush(t.Context(), false)
+	require.NoError(t, err)
+	require.Empty(t, res.Profiles)
+	require.GreaterOrEqual(t, res.Start.UnixMilli(), prev.End.UnixMilli()+2)
+}
+
+func TestPPROFReporter_FlushHold(t *testing.T) {
+	const interval = 5 * time.Millisecond
+	rep := newFlushTestReporter(t, interval)
+
+	// Held: many ticks pass, the sample stays pending
+	_, err := rep.Flush(t.Context(), true)
+	require.NoError(t, err)
+	flushes := rep.flushes()
+	rep.addSample(t, "held")
+	time.Sleep(20 * interval)
+	require.Equal(t, flushes, rep.flushes())
+	require.Len(t, rep.Pending(), 1)
+
+	// The next flush w/o hold gets it + releases the ticker
+	res, err := rep.Flush(t.Context(), false)
+	require.NoError(t, err)
+	require.Len(t, res.Profiles, 1)
+	rep.addSample(t, "released")
+	require.Eventually(t, func() bool { return len(rep.Pending()) == 0 },
+		5*time.Second, interval)
+}
+
+// W/o the reporting loop, Flush waits for ctx.
+func TestPPROFReporter_FlushNotStarted(t *testing.T) {
+	rep := newReporter()
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Millisecond)
+	defer cancel()
+	_, err := rep.Flush(ctx, false)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+}
+
+func TestPPROFReporter_Pending(t *testing.T) {
+	rep := newReporter()
+	// Equal profile types as different pointers sum up
+	cpuType := *profileTypeSampling
+	events := func(timestamps ...uint64) samples.SampleToEvents {
+		return samples.SampleToEvents{
+			{}: &samples.TraceEvents{Timestamps: timestamps},
+		}
+	}
+	tree := rep.traceEvents.WLock()
+	*tree = samples.TraceEventsTree{
+		{PID: 1}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+			profileTypeSampling: events(1, 2),
+			&cpuType:            events(3),
+			profileTypeOffCPU:   events(4),
+		}},
+		{PID: 2}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+			profileTypeSampling: events(5),
+		}},
+	}
+	rep.traceEvents.WUnlock(&tree)
+
+	require.ElementsMatch(t, []PendingSamples{
+		{PID: 1, Type: discovery.MetricValueProcessCPU, Samples: 3},
+		{PID: 1, Type: discovery.MetricValueOffCPU, Samples: 1},
+		{PID: 2, Type: discovery.MetricValueProcessCPU, Samples: 1},
+	}, rep.Pending())
+}
