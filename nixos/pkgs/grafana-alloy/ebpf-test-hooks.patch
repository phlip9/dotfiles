diff -ruN a/internal/component/pyroscope/ebpf/testhooks_linux.go b/internal/component/pyroscope/ebpf/testhooks_linux.go
--- a/internal/component/pyroscope/ebpf/testhooks_linux.go
+++ b/internal/component/pyroscope/ebpf/testhooks_linux.go
@@ -0,0 +1,152 @@
+//go:build linux && (arm64 || amd64)
+
+package ebpf
+
+import (
+	"cmp"
+	"encoding/json"
+	"net/http"
+	"slices"
+	"strconv"
+
+	"github.com/grafana/alloy/internal/component/pyroscope/ebpf/reporter"
+)
+
+// Test hooks, w/ `test_hooks = true`, for tests that must order their
+// steps w/ the reporter's flushes + the applied targets instead of racing
+// timers. Under /api/v0/component/<id>/:
+//
+//   - POST /flush[?hold=true]: flush now, return once the flush's pushes
+//     returned. `hold`: then skip periodic flushes until the next
+//     /flush w/o it. Returns flushResp.
+//   - GET /targets: the pid -> target map the reporter resolves from, as
+//     applied (args updates are async). Returns targetsResp.
+//   - GET /pending: samples awaiting the next flush, per pid + profile
+//     type. Returns pendingResp.
+//
+// Unauthenticated + can stall profiling, so never on by default.
+
+// flushResp is the result of POST /flush.
+type flushResp struct {
+	// Its profiles are stamped in [StartMs, EndMs), and no other flush's
+	// in [StartMs - 1, EndMs]: a query window for exactly this flush.
+	StartMs int64 `json:"start_ms"`
+	EndMs   int64 `json:"end_ms"`
+	Held    bool  `json:"held"`
+	// Failed + dropped pushes while the request ran, incl. a periodic
+	// flush it waited for: 0 = every profile below was pushed.
+	FailedPushes int64            `json:"failed_pushes"`
+	Profiles     []flushedProfile `json:"profiles"`
+}
+
+// flushedProfile is one pushed profile of a flushResp.
+type flushedProfile struct {
+	Labels map[string]string `json:"labels"`
+	// Sample rows, after compaction
+	Samples int `json:"samples"`
+	Bytes   int `json:"bytes"`
+}
+
+// targetsResp is the result of GET /targets, see TargetsSnapshot.
+type targetsResp struct {
+	Live   []pidTarget `json:"live"`
+	Exited []pidTarget `json:"exited"`
+}
+
+// pidTarget is one pid's target in a targetsResp.
+type pidTarget struct {
+	PID    uint32            `json:"pid"`
+	Labels map[string]string `json:"labels"`
+	// When it left the targets; exited pids only
+	SinceMs int64 `json:"since_ms,omitempty"`
+}
+
+// pendingResp is the result of GET /pending.
+type pendingResp struct {
+	Pending []reporter.PendingSamples `json:"pending"`
+}
+
+// Handler implements the HTTP service's component handler: the test hooks,
+// or nil (404, as w/o a handler) w/o `test_hooks`.
+func (c *Component) Handler() http.Handler {
+	if !c.testHooks {
+		return nil
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /flush", c.serveFlush)
+	mux.HandleFunc("GET /targets", c.serveTargets)
+	mux.HandleFunc("GET /pending", c.servePending)
+	return mux
+}
+
+func (c *Component) serveFlush(w http.ResponseWriter, r *http.Request) {
+	hold := false
+	if v := r.URL.Query().Get("hold"); v != "" {
+		var err error
+		if hold, err = strconv.ParseBool(v); err != nil {
+			http.Error(w, "bad hold: "+err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	failures0 := c.pushFailures.Load()
+	res, err := c.reporter.Flush(r.Context(), hold)
+	if err != nil {
+		http.Error(w, "flush: "+err.Error(), http.StatusServiceUnavailable)
+		return
+	}
+	resp := flushResp{
+		StartMs:      res.Start.UnixMilli(),
+		EndMs:        res.End.UnixMilli() + 1,
+		Held:         hold,
+		FailedPushes: c.pushFailures.Load() - failures0,
+		Profiles:     make([]flushedProfile, 0, len(res.Profiles)),
+	}
+	for _, prof := range res.Profiles {
+		resp.Profiles = append(resp.Profiles, flushedProfile{
+			Labels:  prof.Labels.Map(),
+			Samples: prof.Samples,
+			Bytes:   len(prof.Raw),
+		})
+	}
+	writeJSON(w, resp)
+}
+
+func (c *Component) serveTargets(w http.ResponseWriter, _ *http.Request) {
+	snap := c.targetFinder.Snapshot()
+	resp := targetsResp{
+		Live:   make([]pidTarget, 0, len(snap.Live)),
+		Exited: make([]pidTarget, 0, len(snap.Exited)),
+	}
+	for _, target := range snap.Live {
+		resp.Live = append(resp.Live, pidTarget{
+			PID:    target.PID,
+			Labels: target.Labels.Map(),
+		})
+	}
+	for _, target := range snap.Exited {
+		resp.Exited = append(resp.Exited, pidTarget{
+			PID:     target.PID,
+			Labels:  target.Labels.Map(),
+			SinceMs: target.Since.UnixMilli(),
+		})
+	}
+	byPID := func(a, b pidTarget) int { return cmp.Compare(a.PID, b.PID) }
+	slices.SortFunc(resp.Live, byPID)
+	slices.SortFunc(resp.Exited, byPID)
+	writeJSON(w, resp)
+}
+
+func (c *Component) servePending(w http.ResponseWriter, _ *http.Request) {
+	pending := c.reporter.Pending()
+	slices.SortFunc(pending, func(a, b reporter.PendingSamples) int {
+		return cmp.Or(cmp.Compare(a.PID, b.PID), cmp.Compare(a.Type, b.Type))
+	})
+	writeJSON(w, pendingResp{Pending: pending})
+}
+
+func writeJSON(w http.ResponseWriter, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	}
+}
diff -ruN a/internal/component/pyroscope/ebpf/testhooks_test.go b/internal/component/pyroscope/ebpf/testhooks_test.go
--- a/internal/component/pyroscope/ebpf/testhooks_test.go
+++ b/internal/component/pyroscope/ebpf/testhooks_test.go
@@ -0,0 +1,172 @@
+//go:build (linux && arm64) || (linux && amd64)
+
+package ebpf
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/prometheus/model/labels"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/ebpf-profiler/libpf"
+	"go.opentelemetry.io/ebpf-profiler/reporter/samples"
+
+	"github.com/grafana/alloy/internal/component/pyroscope"
+	alloydiscovery "github.com/grafana/alloy/internal/component/pyroscope/ebpf/discovery"
+	"github.com/grafana/alloy/internal/component/pyroscope/ebpf/reporter"
+	"github.com/grafana/alloy/internal/util"
+)
+
+// testHooksTargets are pid 1 = service_a, or none
+func testHooksTargets(live bool) alloydiscovery.TargetsOptions {
+	opts := alloydiscovery.TargetsOptions{
+		DefaultTarget:   alloydiscovery.DiscoveredTarget{"service_name": "ebpf/unspecified"},
+		ExitedRetention: time.Minute,
+	}
+	if live {
+		opts.Targets = []alloydiscovery.DiscoveredTarget{
+			{"__process_pid__": "1", "service_name": "service_a"},
+		}
+	}
+	return opts
+}
+
+// newTestHooksComponent is a component w/ test hooks, a started reporter
+// that only flushes on demand, and `appendFn` as pyroscope.write.
+func newTestHooksComponent(
+	t *testing.T,
+	appendFn func(context.Context, labels.Labels, []*pyroscope.RawSample) error,
+) *Component {
+	reg := prometheus.NewRegistry()
+	c := &Component{testHooks: true}
+	c.logger = util.TestAlloyLogger(t).Slog()
+	c.metrics = newMetrics(reg)
+	c.args.CollectInterval = time.Second
+	c.appendable = pyroscope.NewFanout([]pyroscope.Appendable{
+		pyroscope.AppendableFunc(appendFn),
+	}, "", reg)
+	c.targetFinder = alloydiscovery.NewTargetProducer(testHooksTargets(true))
+	c.reporter = reporter.NewPPROF(c.logger,
+		&reporter.Config{ReportInterval: time.Hour, SamplesPerSecond: 97},
+		c.targetFinder, nil, c.sendProfiles)
+	require.NoError(t, c.reporter.Start(t.Context()))
+	t.Cleanup(c.reporter.Stop)
+	return c
+}
+
+// addTestHooksSample adds one CPU sample of pid 1, as the profiler does.
+func addTestHooksSample(t *testing.T, c *Component) {
+	frames := make(libpf.Frames, 0, 1)
+	frames.Append(&libpf.Frame{
+		Type:         libpf.PythonFrame,
+		FunctionName: libpf.Intern("fn"),
+		SourceFile:   libpf.Intern("a.py"),
+	})
+	require.NoError(t, c.reporter.ReportTraceEvent(
+		&libpf.Trace{Frames: frames},
+		&samples.TraceEventMeta{
+			PID:         1,
+			ProfileType: &samples.TypeMetadata{SampleType: "samples", SampleUnit: "count"},
+		},
+	))
+}
+
+// testHooksDo sends one request to c's hooks, returns the status + body.
+func testHooksDo(t *testing.T, c *Component, method, path string) (int, string) {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequestWithContext(t.Context(), method, path, nil)
+	c.Handler().ServeHTTP(rec, req)
+	return rec.Code, rec.Body.String()
+}
+
+// testHooksJSON sends one request to c's hooks, decodes the 200 resp.
+func testHooksJSON[T any](t *testing.T, c *Component, method, path string) T {
+	code, body := testHooksDo(t, c, method, path)
+	require.Equal(t, http.StatusOK, code, body)
+	var res T
+	require.NoError(t, json.Unmarshal([]byte(body), &res), body)
+	return res
+}
+
+func TestTestHooksOff(t *testing.T) {
+	require.Nil(t, new(Component).Handler())
+}
+
+func TestTestHooksFlush(t *testing.T) {
+	var pushed []labels.Labels
+	c := newTestHooksComponent(t, func(_ context.Context, ls labels.Labels, _ []*pyroscope.RawSample) error {
+		pushed = append(pushed, ls)
+		return nil
+	})
+	addTestHooksSample(t, c)
+
+	resp := testHooksJSON[flushResp](t, c, "POST", "/flush?hold=true")
+	require.True(t, resp.Held)
+	require.Zero(t, resp.FailedPushes)
+	require.Less(t, resp.StartMs, resp.EndMs)
+	require.Len(t, resp.Profiles, 1)
+	require.Equal(t, "service_a", resp.Profiles[0].Labels["service_name"])
+	require.Equal(t, "process_cpu", resp.Profiles[0].Labels["__name__"])
+	require.Equal(t, 1, resp.Profiles[0].Samples)
+	require.Positive(t, resp.Profiles[0].Bytes)
+	// Pushed before the response
+	require.Len(t, pushed, 1)
+
+	resp = testHooksJSON[flushResp](t, c, "POST", "/flush")
+	require.False(t, resp.Held)
+	require.Empty(t, resp.Profiles)
+
+	code, _ := testHooksDo(t, c, "GET", "/flush")
+	require.Equal(t, http.StatusMethodNotAllowed, code)
+	code, _ = testHooksDo(t, c, "POST", "/flush?hold=maybe")
+	require.Equal(t, http.StatusBadRequest, code)
+}
+
+func TestTestHooksFlushFailedPushes(t *testing.T) {
+	c := newTestHooksComponent(t, func(context.Context, labels.Labels, []*pyroscope.RawSample) error {
+		return errors.New("push failed")
+	})
+	addTestHooksSample(t, c)
+	resp := testHooksJSON[flushResp](t, c, "POST", "/flush")
+	require.EqualValues(t, 1, resp.FailedPushes)
+	require.Len(t, resp.Profiles, 1)
+}
+
+func TestTestHooksTargetsPending(t *testing.T) {
+	c := newTestHooksComponent(t, func(context.Context, labels.Labels, []*pyroscope.RawSample) error {
+		return nil
+	})
+
+	targets := testHooksJSON[targetsResp](t, c, "GET", "/targets")
+	require.Len(t, targets.Live, 1)
+	require.Equal(t, uint32(1), targets.Live[0].PID)
+	require.Equal(t, "service_a", targets.Live[0].Labels["service_name"])
+	require.Empty(t, targets.Exited)
+
+	// Applied removal: exited, w/ when
+	before := time.Now().UnixMilli()
+	c.targetFinder.Update(testHooksTargets(false))
+	targets = testHooksJSON[targetsResp](t, c, "GET", "/targets")
+	require.Empty(t, targets.Live)
+	require.Len(t, targets.Exited, 1)
+	require.Equal(t, uint32(1), targets.Exited[0].PID)
+	require.GreaterOrEqual(t, targets.Exited[0].SinceMs, before)
+	_, body := testHooksDo(t, c, "GET", "/targets")
+	require.True(t, strings.Contains(body, `"live":[]`), body)
+
+	pending := testHooksJSON[pendingResp](t, c, "GET", "/pending")
+	require.Empty(t, pending.Pending)
+	addTestHooksSample(t, c)
+	addTestHooksSample(t, c)
+	pending = testHooksJSON[pendingResp](t, c, "GET", "/pending")
+	require.Equal(t, []reporter.PendingSamples{
+		{PID: 1, Type: "process_cpu", Samples: 2},
+	}, pending.Pending)
+}
