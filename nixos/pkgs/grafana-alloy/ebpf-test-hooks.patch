+package discovery
+
+import (
+	"time"
+
+	"github.com/prometheus/prometheus/model/labels"
+)
+
+// TargetsSnapshot is the pid -> target map FindTarget resolves from now,
+// i.e. after Update applied the targets. Test hook.
+type TargetsSnapshot struct {
+	// Pids in Targets
+	Live []PIDTarget
+	// Pids that left Targets, still within ExitedRetention
+	Exited []PIDTarget
+}
+
+// PIDTarget is one pid's target in a TargetsSnapshot.
+type PIDTarget struct {
+	PID    uint32
+	Labels labels.Labels
+	// When the pid left Targets. Zero for live pids.
+	Since time.Time
+}
+
+func (tf *targetProducer) Snapshot() TargetsSnapshot {
+	tf.sync.Lock()
+	defer tf.sync.Unlock()
+	var res TargetsSnapshot
+	for pid, target := range tf.pid2target {
+		res.Live = append(res.Live, PIDTarget{PID: pid, Labels: target.labels})
+	}
+	// Expired entries linger until the next Update or lookup
+	now := tf.now()
+	for pid, exited := range tf.exited {
+		if now.Sub(exited.since) < tf.retention {
+			res.Exited = append(res.Exited, PIDTarget{
+				PID:    pid,
+				Labels: exited.target.labels,
+				Since:  exited.since,
+			})
+		}
+	}
+	return res
+}
diff -ruN a/internal/component/pyroscope/ebpf/discovery/snapshot_test.go b/internal/component/pyroscope/ebpf/discovery/snapshot_test.go
