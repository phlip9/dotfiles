 // Append implements the Appender interface.
 func (f *fanOutClient) Append(ctx context.Context, lbs labels.Labels, samples []*pyroscope.RawSample) error {
+	series, err := f.protoSeries(lbs, samples)
+	if err != nil {
+		return err
+	}
+	// push to all clients
+	_, err = f.Push(ctx, connect.NewRequest(&pushv1.PushRequest{
+		Series: []*pushv1.RawProfileSeries{series},
+	}))
+	return err
+}
+
+const (
+	// maxBatchBytes is a soft target for the raw profile bytes per push
+	// request of AppendBatch: a batch is split before a series that would
+	// exceed it. Labels and protobuf framing aren't counted, and a single
+	// series above it still goes in a request of its own, so it doesn't
+	// bound the request size.
+	maxBatchBytes = 4 << 20
+	// maxBatchConcurrency bounds the requests of one AppendBatch in
+	// flight, like the per-profile senders bound theirs.
+	maxBatchConcurrency = 4
+)
+
+// AppendBatch implements the pyroscope.BatchAppender interface: it pushes
+// all series in one request, or in a few above maxBatchBytes, at most
+// maxBatchConcurrency at once. Series with invalid labels are skipped, the
+// rest are still pushed. Each request fails or retries as a whole.
+// Requests not started before ctx is done are dropped.
+func (f *fanOutClient) AppendBatch(ctx context.Context, series []pyroscope.Series) error {
+	var (
+		errs     error
+		errorMut sync.Mutex
+		reqs     []*pushv1.PushRequest
+		reqBytes int
+	)
+	for _, s := range series {
+		protoSeries, err := f.protoSeries(s.Labels, s.Samples)
+		if err != nil {
+			errs = errors.Join(errs, err)
+			continue
+		}
+		size := 0
+		for _, sample := range protoSeries.Samples {
+			size += len(sample.RawProfile)
+		}
+		// Start a new request if this series would overflow the current one
+		if len(reqs) == 0 || reqBytes+size > maxBatchBytes {
+			reqs = append(reqs, &pushv1.PushRequest{})
+			reqBytes = 0
+		}
+		req := reqs[len(reqs)-1]
+		req.Series = append(req.Series, protoSeries)
+		reqBytes += size
+	}
+
+	var (
+		wg      sync.WaitGroup
+		sem     = make(chan struct{}, maxBatchConcurrency)
+		skipped = 0
+	)
+	for _, req := range reqs {
+		// Once ctx is done, drop the requests not started yet
+		if ctx.Err() == nil {
+			select {
+			case sem <- struct{}{}:
+			case <-ctx.Done():
+			}
+		}
+		if ctx.Err() != nil {
+			f.dropRequest(connect.NewRequest(req))
+			skipped++
+			continue
+		}
+		wg.Add(1)
+		go func() {
+			defer func() {
+				<-sem
+				wg.Done()
+			}()
+			if _, err := f.Push(ctx, connect.NewRequest(req)); err != nil {
+				util.ErrorsJoinConcurrent(&errs, err, &errorMut)
+			}
+		}()
+	}
+	wg.Wait()
+	if skipped > 0 {
+		errs = errors.Join(errs, fmt.Errorf("dropped %d of %d batch requests: %w", skipped, len(reqs), context.Cause(ctx)))
+	}
+	return errs
+}
+
+// dropRequest counts a request that was never sent as dropped, for every
+// endpoint, like Push does for a failed one.
+func (f *fanOutClient) dropRequest(req *connect.Request[pushv1.PushRequest]) {
+	size, profiles := requestSize(req)
+	for _, ec := range f.endpoints {
+		f.metrics.droppedBytes.WithLabelValues(ec.options.URL).Add(float64(size))
+		f.metrics.droppedProfiles.WithLabelValues(ec.options.URL).Add(float64(profiles))
+	}
