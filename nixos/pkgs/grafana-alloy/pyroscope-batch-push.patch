+		done := make(chan error, 1)
+		go func() {
+			done <- appender.AppendBatch(ctx, manyRequests())
+		}()
+		require.Eventually(t, func() bool {
+			return received() == maxBatchConcurrency
+		}, 5*time.Second, 5*time.Millisecond)
+		cancel()
+		err := waitDone(t, done)
+		require.ErrorIs(t, err, context.Canceled)
+		require.ErrorContains(t, err, "dropped 2 of 6 batch requests")
+		// The requests in flight fail, the rest is never sent: all dropped
+		require.Len(t, takeRequests(), maxBatchConcurrency)
+		dropped := promtestutil.ToFloat64(c.metrics.droppedProfiles.WithLabelValues(server.URL)) - dropped0
+		require.Equal(t, float64(maxBatchConcurrency+2), dropped)
+	})
+}
