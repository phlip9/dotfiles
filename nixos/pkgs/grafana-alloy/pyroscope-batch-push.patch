+func Test_FanOut_AppendBatch(t *testing.T) {
+	totalBatches := atomic.NewInt32(0)
+	series := []Series{
+		{Labels: labels.FromStrings("foo", "a")},
+		{Labels: labels.FromStrings("foo", "b")},
+	}
+	batchFunc := func(err error) BatchAppenderMock {
+		return AppendableBatchFunc(func(_ context.Context, s []Series) error {
+			require.Equal(t, series, s)
+			totalBatches.Inc()
+			return err
+		})
+	}
+
+	// Every child takes batches: so does the fanout
+	f := NewFanout([]Appendable{
+		batchFunc(nil),
+		batchFunc(nil),
+	}, "foo", prometheus.NewRegistry())
+	app, ok := f.Appender().(BatchAppender)
+	require.True(t, ok)
+	require.NoError(t, app.AppendBatch(t.Context(), series))
+	require.Equal(t, int32(2), totalBatches.Load())
+
+	f.UpdateChildren([]Appendable{
+		batchFunc(errors.New("foo")),
+		batchFunc(nil),
+	})
+	totalBatches.Store(0)
+	app, ok = f.Appender().(BatchAppender)
+	require.True(t, ok)
+	require.Error(t, app.AppendBatch(t.Context(), series))
+	require.Equal(t, int32(2), totalBatches.Load())
+
+	// One child without batches: the fanout takes none
+	f.UpdateChildren([]Appendable{
+		batchFunc(nil),
+		AppendableFunc(func(_ context.Context, _ labels.Labels, _ []*RawSample) error {
+			return nil
+		}),
+	})
+	_, ok = f.Appender().(BatchAppender)
+	require.False(t, ok)
+}
