+// sendBatch sends all profiles in one AppendBatch.
+func (c *Component) sendBatch(ctx context.Context, appender pyroscope.BatchAppender, ps []reporter.PPROF) {
+	start := time.Now()
+	ctx, cancel := context.WithTimeout(ctx, c.args.CollectInterval)
+	defer cancel()
+
+	series := make([]pyroscope.Series, 0, len(ps))
+	for _, p := range ps {
+		c.observeProfile(p)
+		series = append(series, pyroscope.Series{
+			Labels:  p.Labels,
+			Samples: []*pyroscope.RawSample{{RawProfile: p.Raw}},
+		})
+	}
+	if err := appender.AppendBatch(ctx, series); err != nil {
+		c.logger.Error("ebpf pprof write", "err", err)
+	}
+	c.logger.Debug("sent profiles", "duration", time.Since(start), "count", len(ps))
+}
+
+func (c *Component) observeProfile(p reporter.PPROF) {
+	serviceName := p.Labels.Get("service_name")
+	c.metrics.pprofsTotal.WithLabelValues(serviceName).Inc()
+	c.metrics.pprofSamplesTotal.WithLabelValues(serviceName).Add(float64(p.Samples))
+	c.metrics.pprofBytesTotal.WithLabelValues(serviceName).Add(float64(len(p.Raw)))
+}
