diff -ruN a/internal/component/pyroscope/ebpf/targets_exited_test.go b/internal/component/pyroscope/ebpf/targets_exited_test.go
--- a/internal/component/pyroscope/ebpf/targets_exited_test.go
+++ b/internal/component/pyroscope/ebpf/targets_exited_test.go
@@ -0,0 +1,19 @@
+//go:build (linux && arm64) || (linux && amd64)
+
+package ebpf
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The reporter's ticker is fixed at New, so exited-pid retention must
+// follow it, not a reloaded collect_interval.
+func TestTargetsOptionsExitedRetentionFollowsReporter(t *testing.T) {
+	args := NewDefaultArguments()
+	args.CollectInterval = time.Second
+	opts := args.targetsOptions(false, 15*time.Second)
+	require.Equal(t, 30*time.Second, opts.ExitedRetention)
+}
