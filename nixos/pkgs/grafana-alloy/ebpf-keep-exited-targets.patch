diff -ruN a/internal/component/pyroscope/ebpf/discovery/target_exited_test.go b/internal/component/pyroscope/ebpf/discovery/target_exited_test.go
--- a/internal/component/pyroscope/ebpf/discovery/target_exited_test.go
+++ b/internal/component/pyroscope/ebpf/discovery/target_exited_test.go
@@ -0,0 +1,98 @@
+package discovery
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// fakeClock is a manually advanced clock for targetProducer.now.
+type fakeClock struct{ now time.Time }
+
+func (c *fakeClock) Now() time.Time { return c.now }
+
+// exitedTestProducer returns a producer w/ a fake clock and pids 10 + 11.
+func exitedTestProducer(
+	t *testing.T, opts func(pids ...string) TargetsOptions,
+) (*targetProducer, *fakeClock) {
+	clock := &fakeClock{now: time.Unix(1000, 0)}
+	tf := &targetProducer{now: clock.Now}
+	tf.setTargets(opts("10", "11"))
+	require.Equal(t, "a10", tf.FindTarget(10, "").ServiceName())
+	return tf, clock
+}
+
+// exitedTestOptions builds TargetsOptions w/ one target per pid, named
+// `a<pid>`.
+func exitedTestOptions(
+	retention time.Duration, targetsOnly bool,
+) func(pids ...string) TargetsOptions {
+	return func(pids ...string) TargetsOptions {
+		targets := make([]DiscoveredTarget, 0, len(pids))
+		for _, pid := range pids {
+			targets = append(targets, DiscoveredTarget{
+				"__process_pid__": pid,
+				"service_name":    "a" + pid,
+			})
+		}
+		return TargetsOptions{
+			Targets:         targets,
+			TargetsOnly:     targetsOnly,
+			DefaultTarget:   DiscoveredTarget{"service_name": "unspecified"},
+			ExitedRetention: retention,
+		}
+	}
+}
+
+func TestExitedTargetRetained(t *testing.T) {
+	opts := exitedTestOptions(30*time.Second, false)
+	tf, clock := exitedTestProducer(t, opts)
+
+	// pid 10 exits: kept, across Updates, until the retention ends
+	tf.Update(opts("11"))
+	clock.now = clock.now.Add(20 * time.Second)
+	tf.Update(opts("11"))
+	require.Equal(t, "a10", tf.FindTarget(10, "").ServiceName())
+	clock.now = clock.now.Add(10 * time.Second)
+	tf.Update(opts("11"))
+	require.Equal(t, "unspecified", tf.FindTarget(10, "").ServiceName())
+
+	// pid 11 exits, then a new process reuses pid 11: live target wins
+	tf.Update(opts())
+	reused := opts()
+	reused.Targets = append(reused.Targets, DiscoveredTarget{
+		"__process_pid__": "11",
+		"service_name":    "b11",
+	})
+	tf.Update(reused)
+	require.Equal(t, "b11", tf.FindTarget(11, "").ServiceName())
+}
+
+func TestExitedTargetExpiresWithoutUpdate(t *testing.T) {
+	opts := exitedTestOptions(30*time.Second, false)
+	tf, clock := exitedTestProducer(t, opts)
+
+	tf.Update(opts("11"))
+	clock.now = clock.now.Add(29 * time.Second)
+	require.Equal(t, "a10", tf.FindTarget(10, "").ServiceName())
+	clock.now = clock.now.Add(time.Second)
+	require.Equal(t, "unspecified", tf.FindTarget(10, "").ServiceName())
+}
+
+func TestExitedTargetTargetsOnly(t *testing.T) {
+	opts := exitedTestOptions(30*time.Second, true)
+	tf, _ := exitedTestProducer(t, opts)
+
+	// removed under TargetsOnly: no target, so the policy stops profiling
+	tf.Update(opts("11"))
+	require.Nil(t, tf.FindTarget(10, ""))
+}
+
+func TestExitedTargetRetentionDisabled(t *testing.T) {
+	opts := exitedTestOptions(0, false)
+	tf, _ := exitedTestProducer(t, opts)
+
+	tf.Update(opts("11"))
+	require.Equal(t, "unspecified", tf.FindTarget(10, "").ServiceName())
+}
