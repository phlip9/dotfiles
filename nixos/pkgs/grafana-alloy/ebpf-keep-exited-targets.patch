+// retainExited returns the exited pids' targets to keep: pids that just
+// left (in the old pid2target, not in `live`), plus earlier ones still
+// younger than the retention. A pid that shows up again is live, not
+// exited.
+func (tf *targetProducer) retainExited(
+	live map[uint32]*Target,
+	now time.Time,
+) map[uint32]exitedTarget {
+	if tf.retention <= 0 {
+		return nil
+	}
+	exited := make(map[uint32]exitedTarget)
+	for pid, prev := range tf.exited {
+		if _, ok := live[pid]; !ok && now.Sub(prev.since) < tf.retention {
+			exited[pid] = prev
+		}
+	}
+	for pid, target := range tf.pid2target {
+		if _, ok := live[pid]; !ok {
+			exited[pid] = exitedTarget{target: target, since: now}
+		}
+	}
+	return exited
+}
+
 func (tf *targetProducer) findTarget(pid uint32, cid string) *Target {
 	if target, ok := tf.pid2target[pid]; ok {
 		return target
 	}
+	// Expire here too, not just on Update: targets may not change for a
+	// long time.
+	if exited, ok := tf.exited[pid]; ok {
+		if tf.now().Sub(exited.since) < tf.retention {
+			return exited.target
+		}
+		delete(tf.exited, pid)
+	}
 
 	return tf.cid2target[containerID(cid)]
 }
