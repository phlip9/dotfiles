+func TestPPROFReporter_LocationsKeepSourceFile(t *testing.T) {
+	// Interpreter frames w/o mapping or address: equal fn name + line,
+	// different files. One pid each, merged into one profile.
+	pyFrame := func(file string) samples.SampleToEvents {
+		return samples.SampleToEvents{
+			{}: &samples.TraceEvents{
+				Frames: singleFrameTrace(libpf.PythonFrame, libpf.FrameMappingFile{}, 0,
+					"main", file, 1),
+				Timestamps: []uint64{42},
+			},
+		}
+	}
+	tp := discovery.NewTargetProducer(discovery.TargetsOptions{
+		Targets: []discovery.DiscoveredTarget{
+			{"__process_pid__": "1", "service_name": "service_a"},
+			{"__process_pid__": "2", "service_name": "service_a"},
+		},
+	})
+	rep := NewPPROF(slog.New(slog.DiscardHandler),
+		&Config{SamplesPerSecond: 97, PerPIDProfile: false},
+		tp, nil, func(context.Context, []PPROF) {})
+	profiles := rep.createMergedProfiles(samples.TraceEventsTree{
+		{PID: 1}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+			profileTypeSampling: pyFrame("a.py"),
+		}},
+		{PID: 2}: {Events: map[*samples.TypeMetadata]samples.SampleToEvents{
+			profileTypeSampling: pyFrame("b.py"),
+		}},
+	})
+	require.Len(t, profiles, 1)
+
+	parsed, err := profile.Parse(bytes.NewReader(profiles[0].Raw))
+	require.NoError(t, err)
+	var files []string
+	for _, s := range parsed.Sample {
+		line := s.Location[0].Line[0]
+		assert.Equal(t, "main", line.Function.Name)
+		assert.Equal(t, int64(1), line.Line)
+		files = append(files, line.Function.Filename)
+	}
+	assert.ElementsMatch(t, []string{"a.py", "b.py"}, files)
+	assert.Len(t, parsed.Location, 2)
+}
