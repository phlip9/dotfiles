+import { memo, useMemo } from "react";
+import { ScrollView, Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import type { CheckoutCommit } from "@getpaseo/protocol/messages";
+import { CODE_SURFACE_DATASET } from "@/styles/code-surface";
+
+/**
+ * The full commit message above a commit's diff: subject, an author / date /
+ * sha line, then the body preformatted in monospace like `git show`. Long
+ * messages scroll inside a capped area so the diff stays visible on phones.
+ */
+export const CommitMessageHeader = memo(function CommitMessageHeader({
+  commit,
+}: {
+  commit: CheckoutCommit;
+}) {
+  const authorDate = useMemo(() => formatCommitDate(commit.authorDate), [commit.authorDate]);
+  const body = commit.body ?? "";
+
+  return (
+    <ScrollView
+      style={styles.container}
+      contentContainerStyle={styles.content}
+      testID="commit-message-header"
+    >
+      <Text selectable style={styles.subject} testID="commit-message-subject">
+        {commit.subject}
+      </Text>
+      <View style={styles.meta}>
+        <Text selectable style={styles.metaText}>
+          {commit.authorName}
+        </Text>
+        <Text selectable style={styles.metaText}>
+          {authorDate}
+        </Text>
+        <Text selectable dataSet={CODE_SURFACE_DATASET} style={styles.sha}>
+          {commit.sha}
+        </Text>
+      </View>
+      {body.length > 0 ? (
+        <Text
+          selectable
+          dataSet={CODE_SURFACE_DATASET}
+          style={styles.body}
+          testID="commit-message-body"
+        >
+          {body}
+        </Text>
+      ) : null}
+    </ScrollView>
+  );
+});
+
+// Absolute local date + time; the commit list already shows the relative age.
+function formatCommitDate(isoDate: string): string {
+  const date = new Date(isoDate);
+  if (Number.isNaN(date.getTime())) {
+    return isoDate;
+  }
+  return date.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: {
+    flexGrow: 0,
+    flexShrink: 0,
+    maxHeight: "40%",
+    borderBottomWidth: 1,
+    borderBottomColor: theme.colors.border,
+  },
+  content: {
+    gap: theme.spacing[2],
+    paddingHorizontal: theme.spacing[3],
+    paddingVertical: theme.spacing[2],
+  },
+  subject: {
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.semibold,
+    color: theme.colors.foreground,
+  },
+  meta: {
+    flexDirection: "row",
+    flexWrap: "wrap",
+    columnGap: theme.spacing[3],
+    rowGap: theme.spacing[1],
+  },
+  metaText: {
+    fontSize: theme.fontSize.sm,
+    color: theme.colors.foregroundMuted,
+  },
+  sha: {
+    fontSize: theme.fontSize.sm,
+    fontFamily: theme.fontFamily.mono,
+    color: theme.colors.foregroundMuted,
+  },
+  body: {
+    fontSize: theme.fontSize.code,
+    fontFamily: theme.fontFamily.mono,
+    color: theme.colors.foreground,
+  },
+}));
