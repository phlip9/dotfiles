diff --git a/packages/server/src/server/plugins/managed-source.disabled.test.ts b/packages/server/src/server/plugins/managed-source.disabled.test.ts
new file mode 100644
index 000000000..76a3dee05
--- /dev/null
+++ b/packages/server/src/server/plugins/managed-source.disabled.test.ts
@@ -0,0 +1,31 @@
+// paseo-disable-plugin-installs: managed installs never fetch plugin code from
+// a registry, npm, or Git, whatever the source.
+import { existsSync } from "node:fs";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { ManagedPluginSources } from "./managed-source.js";
+
+describe("disabled managed plugin installs", () => {
+  it("rejects every managed source before resolving or fetching it", async () => {
+    const home = await mkdtemp(path.join(tmpdir(), "paseo-managed-disabled-"));
+    try {
+      const sources = new ManagedPluginSources(home, { defaultUrl: "http://127.0.0.1:1/" });
+      for (const source of [
+        "fixture/example",
+        "npm:paseo-fixture-plugin@^1.0.0",
+        "github:fixture/repository",
+        "git:https://127.0.0.1:1/missing.git",
+        "file:///nonexistent/plugin-repository",
+      ]) {
+        await expect(sources.prepareInstall({ source })).rejects.toThrow(
+          `Managed plugin installs are disabled: ${source}`,
+        );
+      }
+      expect(existsSync(path.join(home, "plugins"))).toBe(false);
+    } finally {
+      await rm(home, { recursive: true, force: true });
+    }
+  });
+});
