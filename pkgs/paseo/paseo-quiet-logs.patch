@@ -159,22 +159,39 @@ export interface ForgeCommandFailureParams {
   stdout?: string;
 }
 
+// Max length of the command summary embedded in a ForgeCommandError message.
+const FORGE_COMMAND_SUMMARY_MAX_CHARS = 200;
+
+// One-line, length-capped `<binary> <args...>` for error messages. Batched
+// `gh api graphql` argv carries the full multi-KB query.
+function summarizeForgeCommand(binary: string, args: string[]): string {
+  const command = `${binary} ${args.join(" ")}`.replace(/\s+/g, " ");
+  return command.length > FORGE_COMMAND_SUMMARY_MAX_CHARS
+    ? `${command.slice(0, FORGE_COMMAND_SUMMARY_MAX_CHARS)}...`
+    : command;
+}
+
 export class ForgeCommandError extends Error {
   readonly kind = "command-error";
-  readonly args: string[];
+  // `args` and `stdout` are non-enumerable so pino's err serializer skips
+  // them. Logged, a failed batched GraphQL poll was 10-80 KB per line (full
+  // query argv + response body), repeated every poll.
+  declare readonly args: string[];
   readonly cwd: string;
   readonly exitCode: number | null;
   readonly stderr: string;
-  readonly stdout?: string;
+  declare readonly stdout?: string;
 
   constructor(label: { brand: string; binary: string }, params: ForgeCommandFailureParams) {
-    super(`${label.brand} CLI command failed: ${label.binary} ${params.args.join(" ")}`);
-    this.args = [...params.args];
+    super(
+      `${label.brand} CLI command failed: ${summarizeForgeCommand(label.binary, params.args)}`,
+    );
+    Object.defineProperty(this, "args", { value: [...params.args] });
     this.cwd = params.cwd;
     this.exitCode = params.exitCode;
     this.stderr = params.stderr;
     if (params.stdout !== undefined) {
-      this.stdout = params.stdout;
+      Object.defineProperty(this, "stdout", { value: params.stdout });
     }
   }
 }
