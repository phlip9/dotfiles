diff --git a/packages/server/scripts/plugin-compiler-runtime.mjs b/packages/server/scripts/plugin-compiler-runtime.mjs
new file mode 100644
index 000000000..d91b2da6b
--- /dev/null
+++ b/packages/server/scripts/plugin-compiler-runtime.mjs
@@ -0,0 +1,43 @@
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { assertPluginCompatibility } from "@getpaseo/protocol/plugin-requirements";
+import { z } from "zod";
+import { readPluginManifest } from "./manifest.js";
+
+// Packaged replacement for dist/.../plugins/compiler-build.js, the only module
+// that loads esbuild. Upstream's compiler worker still owns the calls; they
+// read build-time artifacts instead and never fall back to compiling.
+// Keep in sync w/ precompile-builtin-plugins.mjs.
+const PLUGIN_BUNDLES_FILENAME = "paseo-plugin.bundle.json";
+const PluginBundlesSchema = z
+  .object({
+    clientBundle: z.string().min(1).nullable(),
+    serverBundle: z.string().min(1).nullable(),
+  })
+  .strict()
+  .refine((bundles) => bundles.clientBundle !== null || bundles.serverBundle !== null);
+
+async function readBundles(directory) {
+  const artifact = path.join(directory, PLUGIN_BUNDLES_FILENAME);
+  try {
+    return PluginBundlesSchema.parse(JSON.parse(await readFile(artifact, "utf8")));
+  } catch (cause) {
+    throw new Error(`Precompiled plugin artifact missing or invalid: ${artifact}`, { cause });
+  }
+}
+
+export async function compilePlugin(entryPaths) {
+  const entry = entryPaths.server ?? entryPaths.client;
+  if (!entry) throw new Error("Plugin entry points are missing");
+  return readBundles(path.dirname(entry));
+}
+
+// Same manifest checks as upstream, minus compilation.
+export async function compileDirectoryPlugin(directory, version, builtinId) {
+  const manifest = await readPluginManifest(directory);
+  if (builtinId !== undefined && manifest.id !== builtinId) {
+    throw new Error(`Built-in plugin ${builtinId} has manifest ID ${manifest.id}`);
+  }
+  assertPluginCompatibility({ ...manifest, version, runtime: "daemon" });
+  return { ...(await readBundles(directory)), manifest };
+}
diff --git a/packages/server/scripts/precompile-builtin-plugins.mjs b/packages/server/scripts/precompile-builtin-plugins.mjs
new file mode 100644
index 000000000..db5e545e1
--- /dev/null
+++ b/packages/server/scripts/precompile-builtin-plugins.mjs
@@ -0,0 +1,22 @@
+import { readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import {
+  builtinPlugins,
+  resolveBuiltinPluginsRoot,
+} from "../dist/server/server/plugins/builtin/index.js";
+import { compileDirectoryPlugin } from "../dist/server/server/plugins/compiler-build.js";
+
+// Run against the original compiler before Nix replaces it with the artifact
+// loader. Preserve upstream's manifest and dependency-boundary checks.
+// Keep in sync w/ plugin-compiler-runtime.mjs.
+const PLUGIN_BUNDLES_FILENAME = "paseo-plugin.bundle.json";
+const packageJson = new URL("../package.json", import.meta.url);
+const { version } = JSON.parse(await readFile(packageJson, "utf8"));
+const root = resolveBuiltinPluginsRoot();
+for (const id of builtinPlugins) {
+  const directory = path.join(root, id);
+  const { clientBundle, serverBundle } = await compileDirectoryPlugin(directory, version, id);
+  if (!serverBundle) throw new Error(`Built-in plugin ${id} needs a server entry`);
+  const bundles = { clientBundle, serverBundle };
+  await writeFile(path.join(directory, PLUGIN_BUNDLES_FILENAME), JSON.stringify(bundles));
+}
